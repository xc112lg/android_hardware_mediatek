soong_config_module_type {
    name: "target_board_platform_prebuilt_etc",
    module_type: "prebuilt_etc",
    config_namespace: "ANDROID",
    value_variables: ["target_board_platform"],
    properties: [
        "name",
    ],
}

soong_config_module_type {
    name: "mediatek_gadget_prebuilt_defaults",
    module_type: "prebuilt_defaults",
    config_namespace: "mediatek_gadget",
    bool_variables: ["use_custom_usb_gadget_rc"],
    properties: [
        "enabled",
    ],
}



cc_binary {
    name: "android.hardware.usb.gadget-service.mediatek",
    relative_install_path: "hw",
    init_rc: ["android.hardware.usb.gadget-service.rc"],
    vintf_fragments: [
        "android.hardware.usb.gadget-service.xml",
    ],
    vendor: true,
    srcs: [
        "service_gadget.cpp",
        "UsbGadget.cpp",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libutils",
        "android.frameworks.stats-V2-ndk",
        "android.hardware.usb.gadget-V1-ndk",
        "libcutils",
        "libbinder_ndk",
    ],
    static_libs: [
        "libpixelusb-aidl",
    ],
    proprietary: true,
    export_shared_lib_headers: [
        "android.frameworks.stats-V2-ndk",
    ],
}


